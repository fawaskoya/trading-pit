# Copy to .env.local. Local values come from `supabase status`; cloud values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by `pnpm seed` and never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SEED_ADMIN_EMAIL=admin@tradingpit.local
SEED_ADMIN_PASSWORD=tradingpit
